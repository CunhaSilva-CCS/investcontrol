// Prisma schema for Investe Valor — personal fixed-income investment tracker

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum InvestmentType {
  CDB
  LCI
  LCA
  LC
  TESOURO_SELIC
  TESOURO_PREFIXADO
  TESOURO_IPCA
  POUPANCA
  OUTRO
}

enum IndexType {
  CDI
  IPCA
  PREFIXADO
  SELIC
}

enum Liquidity {
  DIARIA
  NO_VENCIMENTO
}

// name, institution, rate, principal and notes hold AES-256-GCM ciphertext (see src/lib/crypto.ts
// and src/lib/investments-repo.ts) — never read or write them directly through `prisma.investment`.
model Investment {
  id             String         @id @default(cuid())
  name           String // encrypted
  institution    String // encrypted
  type           InvestmentType
  indexType      IndexType
  rate           String // encrypted; decrypts to a Float — % of index, IPCA spread, or fixed annual rate depending on indexType
  principal      String // encrypted; decrypts to a Float — initial amount invested (BRL)
  applicationDate DateTime
  maturityDate   DateTime?
  liquidity      Liquidity      @default(NO_VENCIMENTO)
  fgcCovered     Boolean        @default(true)
  notes          String? // encrypted
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

// Global app settings, e.g. current CDI/SELIC/IPCA rates used for projections
model Settings {
  id        String   @id @default("singleton")
  cdiRate   Float    @default(10.65) // annual CDI rate, %
  selicRate Float    @default(10.75) // annual SELIC rate, %
  ipcaRate  Float    @default(4.5) // annual IPCA rate, %
  updatedAt DateTime @updatedAt
}
