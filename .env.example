DATABASE_URL="file:./dev.db"

# AES-256-GCM key used to encrypt sensitive investment fields (name, institution, rate,
# principal, notes) before they touch the database — see src/lib/crypto.ts.
# Generate one with: openssl rand -base64 32
# Required. The app throws on the first read/write of an investment if this is missing
# or not a valid 32-byte base64 key.
ENCRYPTION_KEY=""

# Authentication and password recovery.
APP_URL="http://localhost:3000"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""
